{
  "name": "campus-stores",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @campus/api\" \"npm run dev -w @campus/web\"",
    "build": "npm run build -w @campus/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run build && npm run start -w @campus/api",
    "e2e": "npm run build && node e2e/story.mjs",
    "test": "npm run test -w @campus/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
